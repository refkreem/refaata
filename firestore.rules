rules_version = '2';
// ملاحظة: لم تُنشر هذه القواعد بعد. تقييد الأدوار (مهندس/محاسب/إشراف) يتم حاليًا داخل التطبيق.
// هذه النسخة تشترط تسجيل الدخول فقط؛ انشرها من Firebase Console ← Firestore ← Rules بعد إنشاء المستخدمين.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
